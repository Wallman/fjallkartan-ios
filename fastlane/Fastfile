# Store metadata and screenshot delivery.
#
# `fastlane/metadata/` is checked in and is the source of truth for the copy:
# edit the .txt files directly and the diff of a commit is exactly the diff of
# what Apple will be sent. `fastlane/screenshots/` is generated by
# `tools/compose_screenshots.py` and gitignored, being ~220 MB of derived PNGs.
#
# Authentication uses an App Store Connect API key, so no Apple ID password and
# no 2FA prompt. Export these in `.envrc` alongside the existing R2 credentials:
#
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_CONTENT_B64
#

default_platform(:ios)


# Only PREPARE_FOR_SUBMISSION accepts metadata edits; every other state returns
# 409 from Apple, so fail with an explanation rather than a raw API error.
EDITABLE_HINT = "App Store Connect only accepts metadata edits while the version " \
                "is in 'Prepare for Submission'. If it is In Review or Pending " \
                "Developer Release, wait or remove it from review first."

def asc_api_key
  require_asc_env
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_content: ENV["ASC_KEY_CONTENT_B64"],
    is_key_content_base64: true
  )
end

# Runs a block with the API key exported for a `fastlane deliver` subprocess.
#
# The download subcommand is a separate CLI invocation, so it cannot see the
# in-memory key the actions use. It reads `DELIVER_API_KEY` as JSON, which is
# enough — passing it in the environment keeps the private key out of both the
# command line (visible in `ps`) and the filesystem, unlike the temp key file
# this used to write.
def with_asc_api_key_env
  require "json"

  previous = ENV["DELIVER_API_KEY"]
  ENV["DELIVER_API_KEY"] = JSON.generate(asc_api_key)
  yield
ensure
  ENV["DELIVER_API_KEY"] = previous
end

def require_asc_env
  %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_CONTENT_B64].each do |name|
    UI.user_error!("#{name} is not set — see the comment at the top of the Fastfile") if ENV[name].to_s.empty?
  end
end

# Directories under metadata/ that are not locales. deliver keeps the App
# Review contact details and similar in these, so they must be skipped when
# enumerating languages or they read as a locale missing every field.
META_SUB_DIRS = %w[
  review_information
  trade_representative_contact_information
  app_clip_review_information
  default
].freeze

# Apple's per-field character limits. deliver does not check these.
FIELD_LIMITS = {
  "name" => 30,
  "subtitle" => 30,
  "promotional_text" => 170,
  "keywords" => 100,
  "description" => 4000,
  "release_notes" => 4000,
  "review_notes" => 4000
}.freeze

# Absent from a locale means that locale silently keeps whatever App Store
# Connect already holds, which is not what an incomplete tree usually means.
REQUIRED_FIELDS = %w[name subtitle promotional_text keywords description support_url privacy_url].freeze

def check_metadata!
  metadata = File.expand_path("metadata", __dir__)
  UI.user_error!("no metadata directory at #{metadata}") unless File.directory?(metadata)

  locales = Dir.children(metadata)
                .select { |c| File.directory?(File.join(metadata, c)) }
                .reject { |c| META_SUB_DIRS.include?(c) }
                .sort
  UI.user_error!("no locale directories in #{metadata}") if locales.empty?

  problems = []
  urls = Hash.new { |h, k| h[k] = {} }

  locales.each do |locale|
    REQUIRED_FIELDS.each do |field|
      path = File.join(metadata, locale, "#{field}.txt")
      unless File.exist?(path)
        problems << "#{locale}: missing #{field}.txt"
        next
      end
      # deliver strips before uploading, so measure what Apple will store.
      value = File.read(path).strip
      problems << "#{locale}: #{field} is empty" if value.empty?
      urls[field][locale] = value if field.end_with?("_url")

      limit = FIELD_LIMITS[field]
      if limit && value.length > limit
        problems << "#{locale}: #{field} is #{value.length} characters, limit is #{limit}"
      end
      if field == "keywords" && value.include?(", ")
        problems << "#{locale}: keywords contain ', ' — the space counts towards the 100 character limit and Apple ignores it"
      end
    end

    notes = File.join(metadata, locale, "release_notes.txt")
    if File.exist?(notes)
      value = File.read(notes).strip
      if value.length > FIELD_LIMITS["release_notes"]
        problems << "#{locale}: release_notes is #{value.length} characters, limit is #{FIELD_LIMITS['release_notes']}"
      end
    end
  end

  # The App Review notes are not localized and live outside the locale
  # directories, but Apple limits them like any other field — and the current
  # text sits within a few characters of the ceiling, so an added sentence
  # would fail the upload rather than being truncated.
  notes = File.join(metadata, "review_information", "notes.txt")
  if File.exist?(notes)
    value = File.read(notes).strip
    if value.length > FIELD_LIMITS["review_notes"]
      problems << "review_information/notes is #{value.length} characters, limit is #{FIELD_LIMITS['review_notes']}"
    end
  end

  # The URLs are per-locale files holding the same value everywhere, so changing
  # one means editing all of them. Catch the one that got missed.
  urls.each do |field, values|
    next if values.values.uniq.size <= 1
    problems << "#{field} differs between locales, probably a partial edit: " +
                values.sort.map { |loc, val| "#{loc}=#{val}" }.join(", ")
  end

  unless problems.empty?
    problems.each { |p| UI.error(p) }
    UI.user_error!("metadata failed validation, nothing was uploaded")
  end

  UI.success("ok: #{locales.size} locales within Apple's limits (#{locales.join(', ')})")
end

def require_screenshots!
  screenshots = File.expand_path("screenshots", __dir__)
  locales = File.directory?(screenshots) ? Dir.children(screenshots).reject { |c| c.start_with?(".") } : []
  return unless locales.empty?

  # Gitignored (~220 MB of derived PNGs), so a fresh clone has none and the
  # upload would otherwise "succeed" having sent nothing.
  UI.user_error!("no screenshots in fastlane/screenshots — run tools/compose_screenshots.py first")
end

# Which App Store display type a local file belongs to. compose_screenshots.py
# writes both families into one directory per locale, prefixing the iPad ones.
SCREENSHOT_DISPLAY_TYPES = {
  "APP_IPAD_PRO_3GEN_129" => ->(name) { name.start_with?("ipad-") },
  "APP_IPHONE_67" => ->(name) { !name.start_with?("ipad-") }
}.freeze

# Expected remote state: locale => display type => sorted file names.
def expected_screenshots
  screenshots = File.expand_path("screenshots", __dir__)
  Dir.children(screenshots).reject { |c| c.start_with?(".") }.each_with_object({}) do |locale, out|
    names = Dir.children(File.join(screenshots, locale)).select { |n| n.end_with?(".png") }
    out[locale] = SCREENSHOT_DISPLAY_TYPES.transform_values { |belongs| names.select(&belongs).sort }
                                          .reject { |_, v| v.empty? }
  end
end

# [locale, file name] => { checksum:, size: } for the local tree. App Store
# Connect reports both back per screenshot, which is what lets the repair tell
# a current image from a stale one rather than trusting the file name.
def local_screenshot_fingerprints
  require "digest"

  screenshots = File.expand_path("screenshots", __dir__)
  Dir.children(screenshots).reject { |c| c.start_with?(".") }.each_with_object({}) do |locale, out|
    Dir.children(File.join(screenshots, locale)).select { |n| n.end_with?(".png") }.each do |name|
      path = File.join(screenshots, locale, name)
      out[[locale, name]] = { checksum: Digest::MD5.hexdigest(File.binread(path)), size: File.size(path) }
    end
  end
end

# Apple fills in `sourceFileChecksum` asynchronously, some time after the asset
# itself stops reporting as processing — and for a few screenshots per run it
# never fills it in at all, leaving null against an image that is COMPLETE,
# error-free and byte-for-byte the file we sent (verified by `fileSize`).
#
# That null is the origin of the whole duplicate problem: it is the only thing
# deliver matches on, so it re-uploads a screenshot that is already there, five
# times over, and then fails the lane. Wait briefly for a late checksum, then
# fall back to the size rather than treating Apple's missing metadata as a
# missing screenshot.
CHECKSUM_SETTLE_ATTEMPTS = 4
CHECKSUM_SETTLE_DELAY = 15

# One pass over the remote state. Returns [problems, unsettled, removed].
def inspect_screenshots(prune:)
  require "naturally"

  expected = expected_screenshots
  fingerprints = local_screenshot_fingerprints

  app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
  version = app.get_edit_app_store_version
  UI.user_error!("no editable App Store version found. #{EDITABLE_HINT}") if version.nil?

  removed = 0
  problems = []
  unsettled = []

  version.get_app_store_version_localizations.each do |localization|
    locale = localization.locale
    wanted = expected[locale]
    next if wanted.nil?

    sets = localization.get_app_screenshot_sets
    sets.each do |set|
      display_type = set.screenshot_display_type
      shots = set.app_screenshots || []

      keepers = []
      shots.group_by(&:file_name).each do |name, group|
        local = fingerprints[[locale, name]]
        # Prefer the copy Apple has confirmed is the local file, so pruning can
        # never keep a stale image in preference to a good one — and so the
        # copy that survives is the one deliver will recognise next run.
        keeper = local && (group.find { |s| s.source_file_checksum == local[:checksum] } ||
                           group.find { |s| s.source_file_checksum.nil? && s.file_size == local[:size] })
        keeper ||= group.first
        keepers << keeper

        next if group.size == 1
        unless prune
          problems << "#{locale} #{display_type}: #{name} appears #{group.size} times"
          next
        end
        (group - [keeper]).each do |duplicate|
          duplicate.delete!
          removed += 1
        end
        UI.message("#{locale} #{display_type}: removed #{group.size - 1} duplicate #{name}")
      end

      remaining = prune ? keepers : shots
      incomplete = remaining.reject(&:complete?).map(&:file_name)
      problems << "#{locale} #{display_type}: not finished processing — #{incomplete.join(', ')}" unless incomplete.empty?

      remaining.each do |shot|
        local = fingerprints[[locale, shot.file_name]]
        next if local.nil?
        checksum = shot.source_file_checksum
        next if checksum == local[:checksum]
        if checksum
          problems << "#{locale} #{display_type}: #{shot.file_name} is not the local file — re-run the upload"
        elsif shot.file_size != local[:size]
          unsettled << "#{locale} #{display_type}: #{shot.file_name}"
        end
      end

      got = remaining.map(&:file_name).sort
      want = wanted[display_type]
      if want.nil?
        problems << "#{locale}: unexpected display type #{display_type} with #{got.size} screenshot(s)"
      elsif got != want
        problems << "#{locale} #{display_type}: has #{got.join(', ')}; expected #{want.join(', ')}"
      end

      # deliver sorts the sets as its last step, so a run that raised before
      # then leaves them in whatever order the parallel uploads happened to
      # land in. Redo that here rather than leaving the store page shuffled.
      next unless prune
      sorted = Naturally.sort(keepers, by: :file_name).map(&:id)
      next if keepers.map(&:id) == sorted
      set.reorder_screenshots(app_screenshot_ids: sorted)
      UI.message("#{locale} #{display_type}: restored screenshot order")
    end

    missing = wanted.keys - sets.map(&:screenshot_display_type)
    problems << "#{locale}: no screenshots uploaded for #{missing.join(', ')}" unless missing.empty?
  end

  [problems, unsettled, removed]
end

# deliver's screenshot upload is not idempotent, so verify (and repair) what
# actually landed.
#
# It decides whether an upload succeeded by looking for each local file's
# checksum in `source_file_checksum` on App Store Connect, and Apple leaves that
# null on a handful of images per run (see CHECKSUM_SETTLE_ATTEMPTS). Those read
# as *missing*, so deliver deletes what it thinks are the failures and re-sends
# the whole set — appending a second copy of every screenshot it did recognise.
# It retries that five times before giving up, which is why one run left 71
# surplus images and why the surplus is unpredictable.
#
# This pass is the authority instead: it keeps one copy of each file (preferring
# the one Apple can vouch for), checks it really is the local image, restores the
# display order deliver never got to sort, and fails the lane if a screenshot is
# genuinely missing or stale.
def verify_screenshots!(prune: true)
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: asc_api_key)

  removed_total = 0
  problems = []
  unsettled = []
  attempts = 0

  loop do
    problems, unsettled, removed = inspect_screenshots(prune: prune)
    removed_total += removed
    attempts += 1
    break if unsettled.empty? || !problems.empty? || attempts >= CHECKSUM_SETTLE_ATTEMPTS

    UI.message("App Store Connect is still ingesting #{unsettled.size} screenshot(s); waiting #{CHECKSUM_SETTLE_DELAY}s")
    sleep(CHECKSUM_SETTLE_DELAY)
  end

  problems += unsettled.map { |shot| "#{shot}: App Store Connect reports neither a matching checksum nor a matching file size" }

  UI.important("removed #{removed_total} duplicate screenshot(s)") if removed_total > 0
  UI.user_error!("screenshots on App Store Connect do not match fastlane/screenshots:\n- #{problems.join("\n- ")}") unless problems.empty?
  UI.success("ok: every screenshot set matches fastlane/screenshots")
end

# deliver decides whether its own upload worked by looking for each local file's
# checksum on App Store Connect, and gives up while Apple is still ingesting —
# see the comment on CHECKSUM_SETTLE_ATTEMPTS. By the time it raises it has also
# retried the whole set five times, so what it leaves behind is duplicates
# rather than a missing screenshot, and the failure is usually a false alarm.
#
# Swallowing it here is safe only because verify_screenshots! then checks the
# same thing itself, by checksum, after the ingest has settled — and fails the
# lane if anything really is missing or stale.
DELIVER_SCREENSHOT_VERIFICATION_ERROR = "Failed verification of all screenshots uploaded".freeze

def deliver_and_verify_screenshots!(options)
  begin
    deliver(options)
  rescue FastlaneCore::Interface::FastlaneError => error
    raise unless error.message.to_s.include?(DELIVER_SCREENSHOT_VERIFICATION_ERROR)
    UI.important("deliver could not confirm its own screenshot upload (#{error.message.strip}); checking App Store Connect directly")
  end

  verify_screenshots!
end

# `deliver download_metadata` writes every field it knows about, including ones
# this app does not use. Left in place they turn `git status` into noise and
# hide the drift the pull was run to find, so strip them back to the shape of
# the committed tree.
def scrub_pulled_metadata!
  require "fileutils"

  metadata = File.expand_path("metadata", __dir__)

  # Fields the app leaves unset come back as empty (or newline-only) files.
  # deliver skips empty values on upload anyway, so they carry no meaning.
  removed = Dir.glob(File.join(metadata, "**", "*.txt")).count do |path|
    next false unless File.read(path).strip.empty?
    File.delete(path)
    true
  end
  UI.message("discarded #{removed} empty field files") if removed > 0

  Dir.glob(File.join(metadata, "*")).each do |path|
    Dir.rmdir(path) if File.directory?(path) && Dir.children(path).empty?
  end
end

platform :ios do
  desc "Validate the checked-in copy against Apple's character limits without uploading"
  lane :check_metadata do
    check_metadata!
  end

  desc "Upload text metadata only (no screenshots, no binary)"
  lane :metadata do |options|
    check_metadata!
    UI.important(EDITABLE_HINT)

    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      # All-NONE declaration yielding 4+; see fastlane/app_rating_config.json.
      app_rating_config_path: "fastlane/app_rating_config.json",
      # Without force, deliver renders an HTML preview and waits for a keypress.
      force: options.fetch(:force, true),
      submit_for_review: false,
      # The IAP check falls back to Apple ID auth, which an API key cannot do.
      precheck_include_in_app_purchases: false
    )
  end

  desc "Upload screenshots only (no metadata, no binary)"
  lane :screenshots do |options|
    require_screenshots!
    UI.important(EDITABLE_HINT)

    deliver_and_verify_screenshots!(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      # Default is false, which appends — re-running would accumulate duplicates.
      overwrite_screenshots: true,
      force: options.fetch(:force, true),
      submit_for_review: false,
      precheck_include_in_app_purchases: false,
      app_version: options[:app_version]
    )
  end

  desc "Check App Store Connect's screenshots match fastlane/screenshots, removing duplicates deliver left behind"
  lane :verify_screenshots do |options|
    require_screenshots!
    verify_screenshots!(prune: options.fetch(:prune, true))
  end

  desc "Upload metadata and screenshots together"
  lane :store do |options|
    check_metadata!
    require_screenshots!
    UI.important(EDITABLE_HINT)

    deliver_and_verify_screenshots!(
      api_key: asc_api_key,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      app_rating_config_path: "fastlane/app_rating_config.json",
      force: options.fetch(:force, true),
      submit_for_review: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Overwrite fastlane/metadata with what App Store Connect currently holds, so `git diff` shows any drift"
  lane :pull do
    # Downloading is a deliver subcommand, not the deliver action (which uploads).
    #
    # This writes over the checked-in tree on purpose: the point of committing
    # it is that `fastlane ios pull && git diff` shows exactly what someone
    # changed in the web UI, with no separate directory to compare by hand.
    # Uncommitted edits would be destroyed by that, so refuse to run on a dirty
    # tree and let git be the safety net.
    status = sh("cd .. && git status --porcelain fastlane/metadata", log: false).strip
    unless status.empty?
      UI.user_error!("fastlane/metadata has uncommitted changes; commit or stash them " \
                     "first, because pull overwrites them:\n#{status}")
    end

    # --force here means "overwrite the local files without asking", which is not
    # what it means in the upload lanes. Without it this subcommand cannot prompt
    # when run non-interactively, and exits 0 having downloaded nothing.
    with_asc_api_key_env do
      sh("cd .. && fastlane deliver download_metadata --force " \
         "--metadata_path fastlane/metadata")
    end

    scrub_pulled_metadata!

    diff = sh("cd .. && git status --porcelain fastlane/metadata", log: false).strip
    if diff.empty?
      UI.success("App Store Connect matches the checked-in metadata")
    else
      UI.important("App Store Connect differs from the checked-in metadata; run `git diff fastlane/metadata`")
    end
  end
end
