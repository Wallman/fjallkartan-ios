          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该区域过大，无法下载。请放大后选择较小的区域。"
          }
        }
      }
    },
    "This removes \"%@\" from this device." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette fjerner “%@” fra denne enhed."
          }
        },
