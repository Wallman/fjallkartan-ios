    "This area is too large to download. Zoom in and try a smaller region." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette område er for stort til at hente. Zoom ind, og prøv en mindre region."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Bereich ist zu groß zum Herunterladen. Zoome hinein und versuche eine kleinere Region."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta área es demasiado grande para descargar. Acerca el zoom e inténtalo con una región más pequeña."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä alue on liian suuri ladattavaksi. Lähennä ja yritä pienempää aluetta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette zone est trop grande pour être téléchargée. Zoomez et essayez une région plus petite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quest’area è troppo grande per il download. Ingrandisci e prova con una regione più piccola."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette området er for stort til å laste ned. Zoom inn og prøv en mindre region."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit gebied is te groot om te downloaden. Zoom in en probeer een kleiner gebied."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här området är för stort för att ladda ner. Zooma in och försök med en mindre region."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该区域过大，无法下载。请放大后选择较小的区域。"
          }
        }
      }
    },
    "This removes \"%@\" from this device." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette fjerner “%@” fra denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird „%@“ von diesem Gerät entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina «%@» de este dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä poistaa kohteen ”%@” tästä laitteesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime « %@ » de cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa azione rimuove “%@” da questo dispositivo."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette fjerner «%@» fra denne enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee wordt ‘%@’ van dit apparaat verwijderd."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här tar bort ”%@” från den här enheten."
          }
