    "Tap the download button on the map to save an area for offline use." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på overførselsknappen på kortet for at gemme et område til offlinebrug."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf die Download-Schaltfläche auf der Karte, um einen Bereich offline zu speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el botón de descarga en el mapa para guardar un área para uso sin conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta latauspainiketta kartalla tallentaaksesi alueen offline-käyttöä varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur le bouton de téléchargement sur la carte pour enregistrer une zone hors ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il pulsante di download sulla mappa per salvare un’area da usare offline."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på nedlastingsknappen på kartet for å lagre et område for offlinebruk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op de downloadknop op de kaart om een gebied offline op te slaan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på nedladdningsknappen på kartan för att spara ett område för offlineanvändning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按地图上的下载按钮，即可保存区域供离线使用。"
          }
        }
      }
    },
    "This area is too large to download. Zoom in and try a smaller region." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette område er for stort til at hente. Zoom ind, og prøv en mindre region."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Bereich ist zu groß zum Herunterladen. Zoome hinein und versuche eine kleinere Region."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta área es demasiado grande para descargar. Acerca el zoom e inténtalo con una región más pequeña."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä alue on liian suuri ladattavaksi. Lähennä ja yritä pienempää aluetta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette zone est trop grande pour être téléchargée. Zoomez et essayez une région plus petite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quest’area è troppo grande per il download. Ingrandisci e prova con una regione più piccola."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette området er for stort til å laste ned. Zoom inn og prøv en mindre region."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit gebied is te groot om te downloaden. Zoom in en probeer een kleiner gebied."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här området är för stort för att ladda ner. Zooma in och försök med en mindre region."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该区域过大，无法下载。请放大后选择较小的区域。"
          }
        }
      }
    },
    "This removes the downloaded area for \"%@\" from this device." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette fjerner det hentede område for »%@« fra denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies entfernt den heruntergeladenen Bereich für „%@“ von diesem Gerät."
          }
        },
        "es" : {
