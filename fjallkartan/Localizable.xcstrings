    "This update changes how offline maps are stored. Your previously downloaded offline regions were removed and need to be downloaded again." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne opdatering ændrer den måde, offlinekort gemmes på. Dine tidligere downloadede offlineregioner er blevet fjernet og skal downloades igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Update ändert die Art und Weise, wie Offlinekarten gespeichert werden. Deine zuvor heruntergeladenen Offline-Regionen wurden entfernt und müssen erneut heruntergeladen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta actualización cambia la forma en que se almacenan los mapas sin conexión. Las regiones sin conexión descargadas anteriormente se eliminaron y deben descargarse de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä päivitys muuttaa offline-karttojen tallennustapaa. Aiemmin ladatut offline-alueet poistettiin, ja ne on ladattava uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette mise à jour modifie la façon dont les cartes hors ligne sont stockées. Vos régions hors ligne précédemment téléchargées ont été supprimées et doivent être retéléchargées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo aggiornamento modifica il modo in cui vengono archiviate le mappe offline. Le regioni offline scaricate in precedenza sono state rimosse e devono essere scaricate di nuovo."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
