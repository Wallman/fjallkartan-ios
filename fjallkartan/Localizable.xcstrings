    "Tap download and frame the area. The dashed box is what gets saved." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på download, og indram området. Den stiplede ramme er det, der gemmes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf Laden und rahme das Gebiet ein. Gesichert wird genau der gestrichelte Rahmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca descargar y encuadra la zona. Se guarda exactamente el recuadro discontinuo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta latauspainiketta ja rajaa alue. Katkoviivalaatikko on se, mikä tallennetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez télécharger et cadrez la zone. Le cadre en pointillés est ce qui sera enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca scarica e inquadra l'area. Il riquadro tratteggiato è ciò che viene salvato."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på nedlasting og ram inn området. Den stiplede rammen er det som lagres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op downloaden en kader het gebied in. De stippellijn is wat wordt bewaard."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på hämta och rama in området. Den streckade rutan är det som sparas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按下载并框定区域。虚线框内即为保存范围。"
          }
        }
      }
    },
    "Tap the distance readout to open the terrain profile." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på afstandsvisningen for at åbne terrænprofilen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf die Distanzanzeige, um das Höhenprofil zu öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca la distancia para abrir el perfil del terreno."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa maastoprofiili napauttamalla matkalukemaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez la distance affichée pour ouvrir le profil du terrain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca la distanza per aprire il profilo del terreno."
          }
        },
        "nb" : {
          "stringUnit" : {
