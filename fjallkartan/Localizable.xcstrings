    "Press and hold the map to drop a pin. Tap a pin to rename or delete it." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold fingeren på kortet for at sætte en markør. Tryk på en markør for at omdøbe eller slette den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karte gedrückt halten, um eine Stecknadel zu setzen. Tippe eine Nadel an, um sie umzubenennen oder zu löschen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado el mapa para colocar un marcador. Tócalo para renombrarlo o borrarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää nasta painamalla karttaa pitkään. Napauta nastaa nimetäksesi tai poistaaksesi sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez longuement sur la carte pour poser un repère. Touchez-le pour le renommer ou le supprimer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuta la mappa per aggiungere un segnaposto. Toccalo per rinominarlo o eliminarlo."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold på kartet for å sette en nål. Trykk på en nål for å gi nytt navn eller slette den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd de kaart ingedrukt om een speld te plaatsen. Tik erop om te hernoemen of te verwijderen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll in på kartan för att sätta en nål. Tryck på en nål för att byta namn eller ta bort den."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按地图可放置图钉。点按图钉可重命名或删除。"
          }
        }
      }
    },
