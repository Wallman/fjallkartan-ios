            "value" : "Tik op de afstand om het hoogteprofiel te openen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på avståndet för att öppna terrängprofilen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按距离读数即可打开地形剖面。"
          }
        }
      }
    },
    "Tap the distance to see the elevation profile." : {
      "localizations" : {
        "da" : {
