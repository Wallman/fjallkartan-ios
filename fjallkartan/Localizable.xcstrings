    "Part of this route is outside the covered area, so the totals are a minimum." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En del af ruten ligger uden for det dækkede område, så totalerne er et minimum."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Teil dieser Route liegt außerhalb des abgedeckten Gebiets, die Summen sind daher Mindestwerte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parte de esta ruta está fuera del área cubierta, por lo que los totales son un mínimo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osa reitistä on kattavuusalueen ulkopuolella, joten summat ovat vähimmäisarvoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une partie de cet itinéraire se trouve en dehors de la zone couverte : les totaux sont donc des minimums."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parte di questo percorso è al di fuori dell’area coperta, quindi i totali sono un valore minimo."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En del av denne ruten ligger utenfor det dekkede området, så totalene er et minimum."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een deel van deze route ligt buiten het gedekte gebied, dus de totalen zijn een minimum."
