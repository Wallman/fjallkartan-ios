    "A new version of Fjällkartan is required to continue. Please update the app from the App Store." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ny version af Fjällkartan er nødvendig for at fortsætte. Opdater appen via App Store."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine neue Version von Fjällkartan wird benötigt, um fortzufahren. Bitte aktualisiere die App über den App Store."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita una nueva versión de Fjällkartan para continuar. Actualiza la aplicación desde el App Store."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jatkaaksesi tarvitset uuden version Fjällkartanista. Päivitä sovellus App Storesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une nouvelle version de Fjällkartan est nécessaire pour continuer. Merci de mettre à jour l’application depuis l’App Store."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per continuare è necessaria una nuova versione di Fjällkartan. Aggiorna l’app dall’App Store."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ny versjon av Fjällkartan kreves for å fortsette. Oppdater appen fra App Store."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is een nieuwe versie van Fjällkartan nodig om door te gaan. Werk de app bij via de App Store."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ny version av Fjällkartan krävs för att fortsätta. Uppdatera appen via App Store."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要更新到 Fjällkartan 的新版本才能继续使用。请前往 App Store 更新应用。"
          }
        }
      }
    },
