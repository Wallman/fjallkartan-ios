        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按地图上的下载按钮，即可保存区域供离线使用。"
          }
        }
      }
    },
    "Tap the ruler, then drag to trace your route." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på linealen, og træk derefter for at tegne ruten."
