        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf das Lineal und ziehe dann, um deine Route zu zeichnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca la regla y luego arrastra para trazar tu ruta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta viivainta ja piirrä reitti vetämällä."
