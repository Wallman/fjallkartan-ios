          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op de downloadknop op de kaart om een gebied offline op te slaan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på nedladdningsknappen på kartan för att spara ett område för offlineanvändning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按地图上的下载按钮，即可保存区域供离线使用。"
          }
        }
      }
    },
    "Tap the ruler, then drag to trace your route." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på linealen, og træk derefter for at tegne ruten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf das Lineal und ziehe dann, um deine Route zu zeichnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca la regla y luego arrastra para trazar tu ruta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta viivainta ja piirrä reitti vetämällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez la règle, puis faites glisser pour tracer votre itinéraire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il righello, poi trascina per tracciare il percorso."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på linjalen, og dra for å tegne ruten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op de liniaal en sleep om je route te tekenen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på linjalen och dra för att rita din rutt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按标尺，然后拖动绘制路线。"
          }
        }
      }
    },
    "The dashed box is what gets downloaded." : {
      "localizations" : {
        "da" : {
