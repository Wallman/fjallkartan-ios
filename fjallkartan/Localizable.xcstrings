    "Not enough free space on this device to download this area.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genügend freier Speicherplatz auf diesem Gerät, um diesen Bereich herunterzuladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente espacio libre en este dispositivo para descargar esta área."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä laitteessa ei ole tarpeeksi vapaata tilaa tämän alueen lataamiseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace libre insuffisant sur cet appareil pour télécharger cette zone."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke nok ledig plass på denne enheten til å laste ned dette området."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet genoeg vrije ruimte op dit apparaat om dit gebied te downloaden."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte tillräckligt med ledigt utrymme på den här enheten för att ladda ner det här området."
          }
        }
      }
    },
